@page "/events/legend-click"

<DocExamples Title="Legend Clicked">

    <Description>
        Click on Legend to trigger a event. On pie, donut and polar area charts the click hides or shows the slice,
        as it hides a series on other charts, and does not select it, so <code>OnDataPointSelection</code> does not run.
    </Description>

    <ChildContent>
        <CodeSnippet Title="Basic" ClassName=@typeof(Basic).ToString()>
            <Snippet>
                <Basic />
            </Snippet>
        </CodeSnippet>

        <CodeSnippet Title="No Axis Chart" ClassName=@typeof(NoAxisChart).ToString()>
            <Snippet>
                <NoAxisChart />
            </Snippet>
        </CodeSnippet>
    </ChildContent>


</DocExamples>
