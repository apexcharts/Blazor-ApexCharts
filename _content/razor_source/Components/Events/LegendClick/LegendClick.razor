@page "/events/legend-click"

<DocExamples Title="Legend Clicked">

    <Description>
        Click on Legend to trigger a event. On pie, donut and polar area charts the click also selects the slice,
        so <code>OnDataPointSelection</code> runs too, with <code>SelectedData.Source</code> set to <code>DataPointSelectionSource.Legend</code>.
    </Description>

    <ChildContent>
        <CodeSnippet Title="Basic" ClassName=@typeof(Basic).ToString()>
            <Snippet>
                <Basic />
            </Snippet>
        </CodeSnippet>

        <CodeSnippet Title="No Axis Chart" ClassName=@typeof(NoAxisChart).ToString()>
            <Snippet>
                <NoAxisChart />
            </Snippet>
        </CodeSnippet>
    </ChildContent>


</DocExamples>
