@namespace ApexCharts.Internal
@typeparam TItem

@if (ApexTooltip != null)
{
    @* "hidden" rather than an inline style attribute, which a strict Content Security Policy blocks *@
    <span hidden>
        <span id="tooltip_source_@ChartId">
            @if (Data != null)
            {
                @ApexTooltip(Data)
            }
        </span>
    </span>
}


