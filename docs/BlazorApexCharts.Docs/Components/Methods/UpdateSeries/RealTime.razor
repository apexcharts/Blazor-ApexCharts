@using System.Threading
@using Microsoft.JSInterop
@implements IDisposable

<DemoContainer>
    <ApexChart @ref=chart TItem="TimeSeries"
               Title="Order Net Value"
               XAxisType="XAxisType.Datetime"
               Options=options>

        <ApexPointSeries TItem="TimeSeries"
                         Items="generator.TimeSeries"
                         Name="Gross Value"
                         SeriesType="SeriesType.Line"
                         XValue="@(e => e.Date)"
                         YValue="@(e => e.Value)"
                         OrderBy="e=>e.X" />
    </ApexChart>
</DemoContainer>

@code {
    private ApexChart<TimeSeries> chart;
    private ApexChartOptions<TimeSeries> options;
    private TimeSeriesGenerator generator = new TimeSeriesGenerator(20);
    private readonly CancellationTokenSource updatesCancellation = new();
    private DateTimeOffset maxDate;
    private int counter;

    protected override void OnInitialized()
    {


        options = new ApexChartOptions<TimeSeries>();

        options.Xaxis = new XAxis
            {
                Range = generator.Range
            };

        options.Yaxis = new List<YAxis> {
            new YAxis {
                Max = 100,
                Min = 0 }
        };
        options.Stroke = new Stroke { Curve = Curve.Smooth };
        options.Chart = new Chart
            {
                Animations = new Animations
                {
                    Easing = Easing.Linear,
                    DynamicAnimation = new DynamicAnimation
                    {
                        Speed = 950
                    }
                },
                Toolbar = new Toolbar
                {
                    Show = false
                },
                Zoom = new Zoom
                {
                    Enabled = false
                }
            };
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {
            // A PeriodicTimer loop started here runs every update on the component's dispatcher,
            // so no InvokeAsync and no async void timer callback. Not awaited: it runs until the
            // component is disposed and handles its own errors.
            _ = RunUpdatesAsync(updatesCancellation.Token);
        }
    }

    private async Task RunUpdatesAsync(CancellationToken cancellationToken)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(1));

        try
        {
            // The tick resumes on the dispatcher after any pending disposal, so the token is checked again.
            while (await timer.WaitForNextTickAsync(cancellationToken) && !cancellationToken.IsCancellationRequested)
            {
                try
                {
                    await UpdateChartSeries();
                }
                catch (TaskCanceledException) when (!cancellationToken.IsCancellationRequested)
                {
                    // The browser did not answer in time (a dropped connection in Blazor Server).
                    // This update is lost; the next tick tries again.
                }
            }
        }
        catch (Exception) when (cancellationToken.IsCancellationRequested)
        {
            // Disposed: the updates stopped, and whatever the last call ran into no longer matters.
        }
        catch (JSDisconnectedException)
        {
            // The page was closed: there is no chart left to update.
        }
        catch (Exception ex)
        {
            // Anything else is a real error: report it the way an event handler's error is reported.
            await DispatchExceptionAsync(ex);
        }
    }

    private async Task UpdateChartSeries()
    {
        if (counter > 100) //Reset the chart
        {
            await chart.UpdateSeriesAsync(true);
            counter = 0;
            maxDate = DateTimeOffset.MinValue;
            return;
        }

        if (maxDate == DateTimeOffset.MinValue)
        {
            maxDate = generator.TimeSeries.Max(e => e.Date);
        }

        maxDate = maxDate.AddDays(1);
        await chart.AppendDataAsync(new List<TimeSeries> { generator.GenerateNewPoint(maxDate) });
        counter++;
    }

    public void Dispose() => updatesCancellation.Cancel();
}
