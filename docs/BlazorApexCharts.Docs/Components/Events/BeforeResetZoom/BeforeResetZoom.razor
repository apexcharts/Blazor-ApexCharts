@page "/events/before-reset-zoom"

<DocExamples Title="Before Reset Zoom">

    <Description>
       
        <Alert BackgroundColor=TablerColor.Danger>
            <div class="d-flex">
                <div class="me-2">
                    <Icon TextColor=TablerColor.Danger IconType=@Icons.Alert_triangle Size=40 />
                </div>
                <div>
                    <h4 class="alert-title">Only supported in Blazor WebAssembly!</h4>
                    <div class="text-muted">Event 'OnBeforeResetZoom' is only supported in web assembly. In Blazor Server, and in InteractiveAuto before the WebAssembly files are cached, the reset uses the original range without calling it and writes a warning to the browser console.</div>
                </div>
            </div>
        </Alert>

        <h3>Click the home icon on the chart to reset the zoom</h3>


    </Description>
 
    <ChildContent>
        <CodeSnippet Title="Basic" ClassName=@typeof(Basic).ToString()>
            <Snippet>
                <Basic />
            </Snippet>
        </CodeSnippet>
    

    </ChildContent>

</DocExamples>
