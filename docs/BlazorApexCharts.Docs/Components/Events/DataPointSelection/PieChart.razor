<DemoContainer>
    <ApexChart TItem="Order"
               Title="Order Gross Value"
               OnDataPointSelection="PointSelected">

        <ApexPointSeries TItem="Order"
                         Items="Orders"
                         Name="Gross Value"
                         SeriesType="SeriesType.Pie"
                         XValue="@(e => e.Country)"
                         YAggregate="@(e => e.Sum(e => e.GrossValue))"
                         OrderByDescending="e=>e.Y" />
    </ApexChart>
</DemoContainer>

@if (message != null)
{
    <Alert BackgroundColor="TablerColor.Primary">
        <h3>@message</h3>
    </Alert>
}

@code {
    private List<Order> Orders { get; set; } = SampleData.GetOrders();
    private string message;

    // Runs for a slice click and for a selection made in code; Source tells them apart.
    // A legend click hides or shows the slice and does not select it.
    private void PointSelected(SelectedData<Order> selectedData)
    {
        var state = selectedData.IsSelected ? "selected" : "deselected";

        message = selectedData.Source switch
        {
            DataPointSelectionSource.Legend => $"Legend click {state} {selectedData.DataPoint.X}",
            DataPointSelectionSource.Method => $"Code {state} {selectedData.DataPoint.X}",
            _ => $"Slice click {state} {selectedData.DataPoint.X}"
        };
    }
}
