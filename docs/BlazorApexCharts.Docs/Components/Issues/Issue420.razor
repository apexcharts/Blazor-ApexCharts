@page "/issues/420"

@* Repro for issue 420: a brush chart must not fail when it renders before the chart it targets. *@

<h3>Issue 420: brush chart rendered before its target</h3>

<h5>Brush declared before its target</h5>
<div id="issue420-a">
    <div id="issue420-a-brush-host">
        <ApexChart TItem="Point" Title="Brush" Options="brushA" Height="130" XAxisType="XAxisType.Datetime">
            <ApexPointSeries TItem="Point" Items="data" Name="Value" SeriesType="SeriesType.Area"
                             XValue="@(e => e.Date)" YValue="@(e => e.Value)" OrderBy="e => e.X" />
        </ApexChart>
    </div>
    <div id="issue420-a-target-host">
        <ApexChart TItem="Point" Title="Target" Options="targetA" Height="200" XAxisType="XAxisType.Datetime">
            <ApexPointSeries TItem="Point" Items="data" Name="Value" SeriesType="SeriesType.Line"
                             XValue="@(e => e.Date)" YValue="@(e => e.Value)" OrderBy="e => e.X" />
        </ApexChart>
    </div>
</div>

<h5>Target added later, brush updated while it waits</h5>
<button id="issue420-update-brush" class="btn btn-secondary mb-2" @onclick="UpdateBrushB">Update brush</button>
<button id="issue420-show-target" class="btn btn-primary mb-2" @onclick="() => showTargetB = true">Show target</button>
<button id="issue420-read-image" class="btn btn-secondary mb-2" @onclick="ReadBrushImageB">Read brush image</button>
<p>
    Brush OnRendered count: <span id="issue420-b-brush-rendered">@brushBRendered</span>,
    updates: <span id="issue420-b-updated">@(brushBUpdated ? "sent" : "none")</span>,
    image reads: <span id="issue420-b-image">@brushBImage</span>
</p>
<div id="issue420-b">
    <div id="issue420-b-brush-host">
        <ApexChart TItem="Point" @ref="brushBChart" Title="Brush" Options="brushB" Height="130" XAxisType="XAxisType.Datetime"
                   OnRendered="() => brushBRendered++">
            <ApexPointSeries TItem="Point" Items="brushDataB" Name="Value" SeriesType="SeriesType.Area"
                             XValue="@(e => e.Date)" YValue="@(e => e.Value)" OrderBy="e => e.X" />
        </ApexChart>
    </div>
    @if (showTargetB)
    {
        <div id="issue420-b-target-host">
            <ApexChart TItem="Point" Title="Target" Options="targetB" Height="200" XAxisType="XAxisType.Datetime">
                <ApexPointSeries TItem="Point" Items="data" Name="Value" SeriesType="SeriesType.Line"
                                 XValue="@(e => e.Date)" YValue="@(e => e.Value)" OrderBy="e => e.X" />
            </ApexChart>
        </div>
    }
</div>

<h5>Target id that matches no chart</h5>
<div id="issue420-c-brush-host">
    <ApexChart TItem="Point" Title="Brush" Options="brushC" Height="130" XAxisType="XAxisType.Datetime">
        <ApexPointSeries TItem="Point" Items="data" Name="Value" SeriesType="SeriesType.Area"
                         XValue="@(e => e.Date)" YValue="@(e => e.Value)" OrderBy="e => e.X" />
    </ApexChart>
</div>

@code {
    public class Point
    {
        public DateTimeOffset Date { get; set; }
        public decimal Value { get; set; }
    }

    public const string UpdatedColor = "#E51C15";
    public const decimal UpdatedValue = 99;
    public const string NoteText = "issue420-note";

    private static readonly DateTimeOffset start = new(2024, 1, 1, 0, 0, 0, TimeSpan.Zero);
    private static List<Point> MakeData() => Enumerable.Range(0, 100)
        .Select(i => new Point { Date = start.AddDays(i), Value = 20 + (i * 37 % 60) })
        .ToList();

    private readonly List<Point> data = MakeData();
    private readonly List<Point> brushDataB = MakeData();

    private bool showTargetB;
    private bool brushBUpdated;
    private int brushBRendered;
    private string brushBImage = "none";
    private int brushBImageReads;
    private ApexChart<Point> brushBChart;
    private ApexChartOptions<Point> brushA, targetA, brushB, targetB, brushC;

    protected override void OnInitialized()
    {
        targetA = Target("issue420-a-target");
        brushA = Brush("issue420-a-brush", "issue420-a-target");
        targetB = Target("issue420-b-target");
        brushB = Brush("issue420-b-brush", "issue420-b-target");
        brushC = Brush("issue420-c-brush", "issue420-c-missing");
    }

    // Each call reaches the brush chart while it still waits for its target
    private async Task UpdateBrushB()
    {
        brushB.Colors = new List<string> { UpdatedColor };
        await brushBChart.UpdateOptionsAsync(true, false, false);

        foreach (var point in brushDataB) { point.Value = UpdatedValue; }
        await brushBChart.UpdateSeriesAsync(false);

        await brushBChart.AddXAxisAnnotationAsync(new AnnotationsXAxis
        {
            X = start.AddDays(50).ToUnixTimeMilliseconds(),
            Label = new Label { Text = NoteText }
        }, true);

        brushBUpdated = true;
    }

    // A read while the brush chart waits returns an empty string, after it renders the image
    private async Task ReadBrushImageB()
    {
        var uri = await brushBChart.GetDataUriAsync(new DataUriOptions());
        brushBImageReads++;
        brushBImage = brushBImageReads + ": " + (string.IsNullOrEmpty(uri) ? "empty" : "image");
    }

    private static ApexChartOptions<Point> Target(string id) => new()
    {
        Chart = new Chart { Id = id, Toolbar = new Toolbar { AutoSelected = AutoSelected.Pan, Show = false } }
    };

    private static ApexChartOptions<Point> Brush(string id, string target) => new()
    {
        Chart = new Chart
        {
            Id = id,
            Brush = new ApexCharts.Brush { Enabled = true, Target = target },
            Selection = new Selection
            {
                Enabled = true,
                Xaxis = new SelectionXaxis
                {
                    Min = start.AddDays(30).ToUnixTimeMilliseconds(),
                    Max = start.AddDays(70).ToUnixTimeMilliseconds()
                }
            }
        }
    };
}
