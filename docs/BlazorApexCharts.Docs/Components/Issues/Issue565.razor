@page "/issues/565"

@*
    Repro for issue #565: RenderAsync destroyed the chart and built a new one in the same
    container. The container was shorter while the new chart rendered, the page got shorter and
    the browser moved the scroll position up. The donut has no fixed height, so apexcharts.js
    works its height out while it renders. It sits at the bottom of a long page so that the page
    is scrolled to its end. Used by tests/e2e/specs/issue-565-render-scroll-jump.mjs.

    The chart at the top has Height="100%": apexcharts.js works its height out from the parent of
    the chart's container, a card sized by its content (a min-height and a heading). Its container
    must not be held at its height while it renders again, or the card, and so the chart, grows
    by the heading's height on every render. The two cards below it reach the same 100% in two
    other ways: a responsive entry that overrides a height of 350, and a chart with no height of
    its own, which renders at its automatic height until the spec sets a global height of 100%,
    and then a global responsive entry of 100% (setGlobalOptions).

    The chart above the donut has a height of 350 and a responsive entry with a height of 320,
    both in pixels: its container is still held while it renders again, with no global options,
    with a global height of 100%, and with a global responsive entry of 100%, which its own
    responsive entries replace. The donut stays last, so that a short viewport shows only the
    donut.
*@

<h3>Issue 565: RenderAsync keeps the scroll position</h3>

<div id="issue565-percent-card" style="min-height: 300px; max-width: 700px;">
    <div style="height: 30px;">Chart with a height of 100%</div>
    <ApexChart @ref="percentChart" TItem="Order" Title="Issue 565, 100% height" Height="@("100%")" OnRendered="() => percentRendered++">
        <ApexPointSeries TItem="Order"
                         Items="orders"
                         Name="Gross Value"
                         SeriesType="SeriesType.Bar"
                         XValue="@(e => e.Country)"
                         YValue="@(e => e.Value)" />
    </ApexChart>
</div>
<button id="issue565-percent-render" class="btn btn-primary m-2" @onclick="RenderPercentAgain">Render the 100% chart again</button>
<span id="issue565-percent-rendered">@percentRendered</span>

<div id="issue565-responsive-card" style="min-height: 300px; max-width: 700px;">
    <div style="height: 30px;">Chart with a responsive height of 100%</div>
    <ApexChart @ref="responsiveChart" TItem="Order" Title="Issue 565, responsive 100% height" Height="350" Options="responsiveOptions" OnRendered="() => responsiveRendered++">
        <ApexPointSeries TItem="Order"
                         Items="orders"
                         Name="Gross Value"
                         SeriesType="SeriesType.Bar"
                         XValue="@(e => e.Country)"
                         YValue="@(e => e.Value)" />
    </ApexChart>
</div>
<button id="issue565-responsive-render" class="btn btn-primary m-2" @onclick="RenderResponsiveAgain">Render the responsive chart again</button>
<span id="issue565-responsive-rendered">@responsiveRendered</span>

<div id="issue565-global-card" style="min-height: 300px; max-width: 700px;">
    <div style="height: 30px;">Chart with no height of its own</div>
    <ApexChart @ref="globalChart" TItem="Order" Title="Issue 565, global height" OnRendered="() => globalRendered++">
        <ApexPointSeries TItem="Order"
                         Items="orders"
                         Name="Gross Value"
                         SeriesType="SeriesType.Bar"
                         XValue="@(e => e.Country)"
                         YValue="@(e => e.Value)" />
    </ApexChart>
</div>
<button id="issue565-global-render" class="btn btn-primary m-2" @onclick="RenderGlobalAgain">Render the chart with no height again</button>
<span id="issue565-global-rendered">@globalRendered</span>

<div id="issue565-spacer" style="height: 1600px;">Scroll down to the chart.</div>

<div style="max-width: 700px;">
    <div id="issue565-fixed-chart">
        <ApexChart @ref="fixedChart" TItem="Order" Title="Issue 565, fixed height" Height="350" Options="fixedOptions" OnRendered="() => fixedRendered++">
            <ApexPointSeries TItem="Order"
                             Items="orders"
                             Name="Gross Value"
                             SeriesType="SeriesType.Bar"
                             XValue="@(e => e.Country)"
                             YValue="@(e => e.Value)" />
        </ApexChart>
    </div>

    <button id="issue565-fixed-render" class="btn btn-primary m-2" @onclick="RenderFixedAgain">Render the fixed height chart again</button>
    <span id="issue565-fixed-rendered">@fixedRendered</span>

    <div id="issue565-chart">
        <ApexChart @ref="chart" TItem="Order" Title="Issue 565" OnRendered="() => rendered++">
            <ApexPointSeries TItem="Order"
                             Items="orders"
                             Name="Gross Value"
                             SeriesType="SeriesType.Donut"
                             XValue="@(e => e.Country)"
                             YValue="@(e => e.Value)" />
        </ApexChart>
    </div>

    <button id="issue565-render" class="btn btn-primary m-2" @onclick="RenderAgain">Render again</button>
    <span id="issue565-rendered">@rendered</span>
</div>

@code {
    private ApexChart<Order> chart;
    private ApexChart<Order> percentChart;
    private int rendered;
    private int percentRendered;
    private ApexChart<Order> responsiveChart;
    private ApexChart<Order> globalChart;
    private ApexChart<Order> fixedChart;
    private int responsiveRendered;
    private int globalRendered;
    private int fixedRendered;

    // Breakpoints wider than any viewport the spec uses, so the entries always apply
    private readonly ApexChartOptions<Order> responsiveOptions = new()
    {
        Responsive = [new() { Breakpoint = 5000, Options = new() { Chart = new() { Height = "100%" } } }]
    };

    private readonly ApexChartOptions<Order> fixedOptions = new()
    {
        Responsive = [new() { Breakpoint = 5000, Options = new() { Chart = new() { Height = 320 } } }]
    };

    private readonly List<Order> orders =
    [
        new("Sweden", 120), new("Norway", 90), new("Denmark", 140), new("Finland", 70), new("Iceland", 40)
    ];

    private async Task RenderAgain()
    {
        await chart.RenderAsync();
    }

    private async Task RenderPercentAgain()
    {
        await percentChart.RenderAsync();
    }

    private async Task RenderResponsiveAgain()
    {
        await responsiveChart.RenderAsync();
    }

    private async Task RenderGlobalAgain()
    {
        await globalChart.RenderAsync();
    }

    private async Task RenderFixedAgain()
    {
        await fixedChart.RenderAsync();
    }

    private record Order(string Country, decimal Value);
}
