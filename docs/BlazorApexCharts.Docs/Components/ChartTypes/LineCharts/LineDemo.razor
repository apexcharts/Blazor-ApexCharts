<DemoContainer>
    <ApexChart TItem="Data"
               Title="Order Net Value"
    XAxisType="XAxisType.Datetime">

        <ApexLineSeries TItem="Data"
                        Items="data"
                         Name="Gross Value"
                         SeriesType="SeriesType.Line"
                         XValue="@(e => e.Timestamp)"
                         YValue="@(e => e.Value)"
                         MarkerSize="5"
                         Color="green"
                        MarkerColor="red"
                        Stroke="@(new ApexCharts.SeriesStroke() { DashSpace = 5, Width = 2 })" />

        <ApexLineSeries TItem="Data"
                        Items="data"
                        Name="Gross Value"
                        SeriesType="SeriesType.Line"
                        XValue="@(e => e.Timestamp)"
                        YValue="@(e => e.Value - 10)"
                        Color="red"
                        Stroke="@(new ApexCharts.SeriesStroke() { Width = 1 })" />
    </ApexChart>

</DemoContainer>

@code 
{
    private record Data(DateTimeOffset Timestamp, decimal Value);

    private List<Data> data { get; set; } = new List<Data>
    {
        new Data(DateTimeOffset.Now.AddDays(-5), 100),
        new Data(DateTimeOffset.Now.AddDays(-4), 150),
        new Data(DateTimeOffset.Now.AddDays(-3), 120),
        new Data(DateTimeOffset.Now.AddDays(-2), 180),
        new Data(DateTimeOffset.Now.AddDays(-1), 130),
        new Data(DateTimeOffset.Now, 170)
    };
}