@page "/features/formatters"

<DocExamples Title="Formatters">

     

    <CodeSnippet Title="Use javascript" ClassName=@typeof(UseJavascript).ToString()>
        <Snippet>
            <UseJavascript />
        </Snippet>
    </CodeSnippet>

      <CodeSnippet Title="Donut" ClassName=@typeof(Donut).ToString()>
        <Snippet>
            <Donut />
        </Snippet>
    </CodeSnippet>

    <CodeSnippet Title="Multiple Y Axis" ClassName=@typeof(MultipleYAxis).ToString()>
        <Snippet>
            <MultipleYAxis />
        </Snippet>
    </CodeSnippet>

    <CodeSnippet Title="Pass Extra Data" ClassName=@typeof(ExtraData).ToString()>
        <Snippet>
            <ExtraData />
        </Snippet>
    </CodeSnippet>

    <CodeSnippet Title="Use DotNet" ClassName=@typeof(UseDotnet).ToString()>
        <Description>
            <Alert BackgroundColor=TablerColor.Danger>

                <div class="d-flex">
                    <div class="me-2">
                        <Icon TextColor=TablerColor.Danger IconType=@Icons.Alert_triangle Size=40 />
                    </div>
                    <div>
                        <h4 class="alert-title">Only supported in Blazor WebAssembly!</h4>
                        <div class="text-muted">
                            <p>
                                <code>FormatYAxisLabel</code> and <code>FormatXAxisLabel</code> are called synchronously while the chart draws its labels,
                                and only WebAssembly supports synchronous calls from JavaScript to .NET.
                            </p>
                            <p>
                                In Blazor Server, and in <code>InteractiveAuto</code> on a first visit (it runs on a server circuit until the WebAssembly files are cached),
                                the chart still renders: the axis keeps its default labels and a warning is written to the browser console once per chart.
                            </p>
                            <p class="mb-0">
                                To format labels the same way in every render mode, use a JavaScript formatter (see <em>Use javascript</em> above),
                                or render the page with <code>InteractiveWebAssembly</code>.
                            </p>
                        </div>
                    </div>
                </div>
            </Alert>
        </Description>
        <Snippet>
            <UseDotnet />
        </Snippet>
    </CodeSnippet>

    <CodeSnippet Title="Use DotNet for X Axis" ClassName=@typeof(UseDotNetXAxis).ToString()>
