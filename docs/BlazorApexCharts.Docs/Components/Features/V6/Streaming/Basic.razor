@implements IDisposable
@using System.Threading
@using Microsoft.JSInterop
@*
    ApexCharts v6 streaming. A rolling window bounded to MaxPoints trims old points as new
    data arrives so long-running feeds do not grow memory without bound. This demo appends a
    point automatically on a timer; once past the window size it scrolls at constant velocity.

    The feed is a PeriodicTimer loop started from the renderer, so every tick runs on the
    component's dispatcher (no InvokeAsync, no async void timer callback), disposing the
    component stops it, and no exception can escape it to crash a Blazor Server host.
*@
<div class="mb-2">
    <button class="btn btn-primary" @onclick="ToggleFeed">@(running ? "Pause feed" : "Resume feed")</button>
    <span class="ms-2">Live points: <strong>@points.Count</strong> (window max 50)</span>
</div>

<DemoContainer>
    <ApexChart @ref="chart" TItem="Pt" Title="Streaming rolling window (live)" Options="options">
        <ApexPointSeries TItem="Pt"
                         Items="points"
                         Name="Live"
                         SeriesType="SeriesType.Line"
                         XValue="@(e => e.X)"
                         YValue="@(e => e.Y)"
                         OrderBy="e => e.X" />
    </ApexChart>
</DemoContainer>

@code {
    private ApexChart<Pt> chart;
    private ApexChartOptions<Pt> options { get; set; } = new();
    private List<Pt> points { get; set; } = new();
    private int nextX;
    private bool running = true;
    private readonly Random rnd = new();
    private readonly CancellationTokenSource feedCancellation = new();

    protected override void OnInitialized()
    {
        options.Chart = new Chart
            {
                Height = 320,
                Streaming = new ChartStreaming { Enabled = true, MaxPoints = 50 }
            };

        // Numeric x-axis: without it, ApexCharts converts the category axis to numeric with a
        // per-data-point tick count, which produces duplicate integer labels when zoomed in.
        options.Xaxis = new XAxis { Type = XAxisType.Numeric };

        for (nextX = 0; nextX < 20; nextX++)
        {
            points.Add(new Pt(nextX, rnd.Next(10, 90)));
        }
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {
            // Not awaited: the loop runs until the component is disposed and handles its own errors.
            _ = RunFeedAsync(feedCancellation.Token);
        }
    }

    private async Task RunFeedAsync(CancellationToken cancellationToken)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromMilliseconds(900));

        try
        {
            // The tick resumes on the dispatcher after any pending disposal, so the token is checked again.
            while (await timer.WaitForNextTickAsync(cancellationToken) && !cancellationToken.IsCancellationRequested)
            {
                if (!running) { continue; }

                try
                {
                    await AppendPointAsync();
                }
                catch (TaskCanceledException) when (!cancellationToken.IsCancellationRequested)
                {
                    // The browser did not answer in time (a dropped connection in Blazor Server).
                    // A live feed loses this one point; the next tick tries again.
                }
            }
        }
        catch (Exception) when (cancellationToken.IsCancellationRequested)
        {
            // Disposed: the feed stopped, and whatever the last call ran into no longer matters.
        }
        catch (JSDisconnectedException)
        {
            // The page was closed: there is no chart left to update.
        }
        catch (Exception ex)
        {
            // Anything else is a real error: report it the way an event handler's error is reported.
            await DispatchExceptionAsync(ex);
        }
    }

    private async Task AppendPointAsync()
    {
        var added = new List<Pt> { new(nextX++, rnd.Next(10, 90)) };
        points.Add(added[0]);

        // Keep the C# backing list bounded too; the core trims the rendered window itself.
        if (points.Count > 50)
        {
            points.RemoveRange(0, points.Count - 50);
        }

        await chart.AppendDataAsync(added);
        StateHasChanged();
    }

    private void ToggleFeed() => running = !running;

    public void Dispose() => feedCancellation.Cancel();

    private record Pt(int X, decimal Y);
}
