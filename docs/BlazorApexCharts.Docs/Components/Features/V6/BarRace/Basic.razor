@implements IDisposable
@using System.Threading
@using Microsoft.JSInterop
@*
    ApexCharts v6 bar-chart-race. On a horizontal bar chart, data labels ride to their bar's new
    position (Animate) and count up to the new value (CountUp) as bars re-rank. This demo advances
    automatically on a timer; the bars reorder and the labels count up on every frame.

    The race is a PeriodicTimer loop started from the renderer, so every frame runs on the
    component's dispatcher (no InvokeAsync, no async void timer callback), disposing the
    component stops it, and no exception can escape it to crash a Blazor Server host.
*@
<div class="mb-2">
    <button class="btn btn-primary" @onclick="ToggleRun">@(running ? "Pause" : "Play")</button>
    <span class="ms-2">Frame: <strong>@frame</strong></span>
</div>

<DemoContainer>
    <ApexChart @ref="chart" TItem="Racer" Title="Bar chart race (live)" Options="options">
        <ApexPointSeries TItem="Racer"
                         Items="racers"
                         Name="Score"
                         SeriesType="SeriesType.Bar"
                         ShowDataLabels="true"
                         XValue="@(e => e.Name)"
                         YValue="@(e => e.Value)"
                         OrderByDescending="e => e.Y" />
    </ApexChart>
</DemoContainer>

@code {
    private ApexChart<Racer> chart;
    private ApexChartOptions<Racer> options { get; set; } = new();
    private List<Racer> racers { get; set; } = new();
    private int frame;
    private bool running = true;
    private readonly Random rnd = new();
    private readonly CancellationTokenSource raceCancellation = new();

    protected override void OnInitialized()
    {
        options.Chart = new Chart
            {
                Height = 340,
                Animations = new Animations
                {
                    DynamicAnimation = new DynamicAnimation { Enabled = true, Speed = 900 }
                }
            };

        options.PlotOptions = new PlotOptions
            {
                Bar = new PlotOptionsBar { Horizontal = true }
            };

        options.DataLabels = new DataLabels
            {
                Enabled = true,
                Animate = new DataLabelsAnimate { Enabled = true },
                CountUp = new DataLabelsCountUp { Enabled = true }
            };

        foreach (var name in new[] { "Alpha", "Bravo", "Charlie", "Delta", "Echo" })
        {
            racers.Add(new Racer { Name = name, Value = rnd.Next(20, 100) });
        }
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {
            // Not awaited: the loop runs until the component is disposed and handles its own errors.
            _ = RunRaceAsync(raceCancellation.Token);
        }
    }

    private async Task RunRaceAsync(CancellationToken cancellationToken)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromMilliseconds(1400));

        try
        {
            // The tick resumes on the dispatcher after any pending disposal, so the token is checked again.
            while (await timer.WaitForNextTickAsync(cancellationToken) && !cancellationToken.IsCancellationRequested)
            {
                if (!running) { continue; }

                try
                {
                    await NextFrameAsync();
                }
                catch (TaskCanceledException) when (!cancellationToken.IsCancellationRequested)
                {
                    // The browser did not answer in time (a dropped connection in Blazor Server).
                    // The race skips this frame; the next tick tries again.
                }
            }
        }
        catch (Exception) when (cancellationToken.IsCancellationRequested)
        {
            // Disposed: the race stopped, and whatever the last call ran into no longer matters.
        }
        catch (JSDisconnectedException)
        {
            // The page was closed: there is no chart left to update.
        }
        catch (Exception ex)
        {
            // Anything else is a real error: report it the way an event handler's error is reported.
            await DispatchExceptionAsync(ex);
        }
    }

    private async Task NextFrameAsync()
    {
        frame++;

        // Every few frames, reshuffle from a fresh base so the race keeps re-ranking and
        // values stay in a readable range instead of growing without bound.
        if (frame % 8 == 0)
        {
            foreach (var r in racers) { r.Value = rnd.Next(20, 100); }
        }
        else
        {
            foreach (var r in racers) { r.Value += rnd.Next(0, 40); }
        }

        await chart.UpdateSeriesAsync(true);
        StateHasChanged();
    }

    private void ToggleRun() => running = !running;

    public void Dispose() => raceCancellation.Cancel();

    private class Racer
    {
        public string Name { get; set; }
        public decimal Value { get; set; }
    }
}
