@if (showGlobalOptions)
{
    <div class="offcanvas offcanvas-end show" style="visibility:visible" tabindex="-1" @ref="panelRef" @onkeydown="OnPanelKeyDown">
        <div class="offcanvas-header">
            <h5 class="offcanvas-title">Global Options</h5>
            <button type="button" class="btn-close" @onclick="CloseGlobalOptions"></button>
        </div>
        <div class="offcanvas-body">
            <GlobalOptions />
        </div>
    </div>
    <div class="docs-offcanvas-catcher" @onclick="CloseGlobalOptions"></div>
}
